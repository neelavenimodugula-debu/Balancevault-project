# LedgerLine Environment Configuration Template
# Copy this file to .env and replace secrets before deploying.

# Environment mode: 'development', 'staging', or 'production'
LEDGERLINE_ENVIRONMENT=production

# PostgreSQL Database Connection String
LEDGERLINE_DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Redis Connection String
LEDGERLINE_REDIS_URL=redis://localhost:6379/0

# JWT Authentication Secret (Must be >= 32 characters in production)
LEDGERLINE_JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-32-chars

# Token Expiry (minutes)
LEDGERLINE_TOKEN_EXPIRY_MINUTES=30

# Rate Limiting (requests per minute per client)
LEDGERLINE_RATE_LIMIT_PER_MINUTE=60

# Initial First-Admin Bootstrap Credentials
LEDGERLINE_ADMIN_EMAIL=admin@example.com
LEDGERLINE_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!

# Optional Initial Auditor Bootstrap Credentials
LEDGERLINE_AUDITOR_EMAIL=auditor@example.com
LEDGERLINE_AUDITOR_PASSWORD=ReplaceWithStrongAuditorPassword123!

# Redis Rate Limiting Strictness (false permits in-memory sliding window fallback)
LEDGERLINE_STRICT_REDIS=false

# System Clearing Account Name
LEDGERLINE_CLEARING_ACCOUNT_NAME=SYSTEM_CLEARING
